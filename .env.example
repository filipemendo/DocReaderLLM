# Optional LLM providers. If none are set, the app uses a local extractive fallback.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Defaults used by the chat endpoint.
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4.1-mini

# Local storage for imported/uploaded documents.
DATA_DIR=.data

# Identifies backend URL imports to sites such as Wikipedia.
# Keep the project URL or replace it with your email address.
REMOTE_USER_AGENT="DocReaderLLM/1.0 (https://github.com/filipemendo/DocReaderLLM; local research reader)"
